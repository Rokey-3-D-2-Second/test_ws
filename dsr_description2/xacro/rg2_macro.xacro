<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:macro name="rg2_gripper" params="parent name">
    <!-- 손 본체 -->
    <link name="${name}_hand">
        <visual>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/visual/rg2/hand.dae"/>
        </geometry>
        </visual>
        <collision>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/collision/rg2/hand.stl"/>
        </geometry>
        </collision>
    </link>

    <!-- 왼손가락 -->
    <link name="${name}_leftfinger">
        <visual>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/visual/rg2/finger.dae"/>
        </geometry>
        </visual>
        <collision>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/collision/rg2/finger.stl"/>
        </geometry>
        </collision>
    </link>

    <!-- 오른손가락 -->
    <link name="${name}_rightfinger">
        <visual>
        <origin rpy="3.14 0 0" xyz="0 0 0"/>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/visual/rg2/finger.dae"/>
        </geometry>
        </visual>
        <collision>
        <origin rpy="3.14 0 0" xyz="0 0 0"/>
        <geometry>
            <mesh filename="package://dsr_description2/meshes/gripper/collision/rg2/finger.stl"/>
        </geometry>
        </collision>
    </link>

    <!-- 장착 및 관절 -->
    <joint name="${name}_mount" type="fixed">
        <parent link="${parent}"/>
        <child link="${name}_hand"/>
        <!-- <origin xyz="0 0 0" rpy="1.5708 -1.5708 1.5708"/> -->
        <origin xyz="0 0 0" rpy="0 -1.5708 1.5708"/>
    </joint>

    <joint name="${name}_finger_joint1" type="revolute">
        <parent link="${name}_hand"/>
        <child link="${name}_leftfinger"/>
        <origin xyz="0.105 0.017 0" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit effort="10.6" lower="0.0" upper="1.18" velocity="1.57"/>
    </joint>

    <joint name="${name}_finger_joint2" type="revolute">
        <parent link="${name}_hand"/>
        <child link="${name}_rightfinger"/>
        <origin xyz="0.105 -0.017 0" rpy="0 0 0"/>
        <axis xyz="0 0 -1"/>
        <limit effort="10.6" lower="0.0" upper="1.18" velocity="1.57"/>
        <mimic joint="${name}_finger_joint1"/>
    </joint>

    <!-- tool0 -->
    <link name="tool0"/>
    <joint name="tool0_fixed_joint" type="fixed">
        <parent link="${name}_hand"/>
        <child link="tool0"/>
        <origin xyz="0.21 0 0" rpy="0 0 0"/>
    </joint>

    </xacro:macro>

</robot>
